# Copy to .env and fill in secrets
PIONEER_ENV=development
PIONEER_DEBUG=true
PIONEER_LOG_LEVEL=INFO
PIONEER_LOG_FORMAT=console

# LLM providers
# PIONEER_OPENAI_API_KEY=sk-...
# PIONEER_OPENAI_BASE_URL=https://api.openai.com/v1
PIONEER_DEFAULT_MODEL=gpt-4o-mini

# Paths
PIONEER_DATA_DIR=./data
PIONEER_ARTIFACTS_DIR=./artifacts

# Serving
PIONEER_HOST=0.0.0.0
PIONEER_PORT=8000

# Hugging Face (Hub datasets, Jobs, SFT push)
# HF_TOKEN=hf_...          # write + jobs scopes for training
# HF_USERNAME=your-user    # used to build hub_model_id when omitted

